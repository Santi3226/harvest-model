				<StatechartElement Class="State" ParentState="Harvesting" ParentStateId="1169735952546">
					<Id>1169735952544</Id>
					<Name><![CDATA[WithCart]]></Name>
					<X>190</X><Y>80</Y>
					<Label><X>15</X><Y>15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="340" Height="30">
						<EntryAction><![CDATA[actualizarNivel();
main.cart.actualizarNivel();
// 1) volcado del buffer de la tolva al carro: instantaneo a escala del modelo,
//    y conservativo por construccion (lo que sale de uno entra en el otro)
double espacio = main.cart.Capacity - main.cart.nivel;
double lote = min( nivel, espacio );
nivel -= lote;
main.cart.nivel += lote;
// 2) mientras siguen acoplados el carro recibe exactamente lo que se cosecha,
//    no la tasa nominal de descarga: la tolva ya esta vacia
tasaCosecha = tasaCosechaActual();
tasaActual = 0;
tUltimo = time();
main.cart.tasaActual = tasaCosecha;
main.cart.tUltimo = time();
if ( main.cart.inState( Cart.Loading ) ) { main.cart.Full.cancel(); main.cart.Full.start(); }
// el onChange se movio aca desde StartedUnloading.Action: la Action corre ANTES
// del entry del destino, y transition8 necesita ver WithCart ya activo
moveControl.onChange();]]></EntryAction>
						<ExitAction><![CDATA[send( "COMPLETED", main.cart );
actualizarNivel();
tasaCosecha = tasaCosechaActual();
tasaActual = tasaCosecha;
// se corta el acople: el carro deja de recibir aunque siga en Loading
main.cart.actualizarNivel();
main.cart.tasaActual = 0;]]></ExitAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
