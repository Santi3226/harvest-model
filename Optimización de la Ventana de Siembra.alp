						<EntryAction><![CDATA[// tolva llena: la maquina deja de cosechar
actualizarNivel();
tasaCosecha = 0;
tasaActual = 0;
// el carro se llama desde aca y no desde MoveWaitCart.Entry: si la maquina
// ya estaba parada por jornada/piso, no se reentra a MoveWaitCart y el
// send de su entry no vuelve a correr.
if ( main.autoControl ) send( "GO_TO_COMBINE", main.cart );
moveControl.onChange();]]></EntryAction>
