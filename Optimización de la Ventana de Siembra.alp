				<StatechartElement Class="State" ParentState="AtField" ParentStateId="1169735952745">
					<Id>1169735952743</Id>
					<Name><![CDATA[Loading]]></Name>
					<X>150</X><Y>170</Y>
					<Label><X>10</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="110" Height="30">
						<EntryAction><![CDATA[actualizarNivel();
// la tasa solo vale si el carro esta realmente descargando: sin esta guarda,
// un FINISHED_LOADING perdido por LIFO deja al camion acumulando de la nada
tasaActual = main.cart.inState( Cart.Unloading ) ? main.cart.UnloadingRate / second() : 0;
tUltimo = time();
if ( inState( AtField ) ) { transition5.cancel(); transition5.start(); }]]></EntryAction>
						<ExitAction><![CDATA[actualizarNivel();
tasaActual = 0;]]></ExitAction>
						<FillColor>-6632142</FillColor>
					</Properties>
				</StatechartElement>
