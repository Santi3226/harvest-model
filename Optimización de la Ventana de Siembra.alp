			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1169735952573</Id>
					<Name><![CDATA[YCompletedNow]]></Name>
					<X>250</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[//if moving in the field, use the most current position
if( inState( MoveHarvesting ) )
	return getY() - Field.getY();
//otherwise, use old position
return YCompleted;

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1169735952574</Id>
					<Name><![CDATA[harvestRate]]></Name>
					<X>250</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return getSpeed(MPS) * scale.toLengthUnits(RowWidth, METER) * HarvestDensity;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1786000000304</Id>
					<Name><![CDATA[actualizarNivel]]></Name>
					<X>750</X><Y>380</Y>
					<Label><X>20</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// integra el nivel en unidades de tiempo del modelo
double dt = time() - tUltimo;
// masa que entra al sistema por cosecha (para la auditoria de conservacion)
main.totalCosechado += tasaCosecha * dt;
double bruto = nivel + tasaActual * dt;
if ( bruto > Capacity ) { main.masaDescartada += bruto - Capacity; bruto = Capacity; }
if ( bruto < 0 )        { main.masaInventada  += -bruto;           bruto = 0; }
nivel = bruto;
tUltimo = time();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786000001101</Id>
					<Name><![CDATA[puedeTrabajar]]></Name>
					<X>750</X><Y>460</Y>
					<Label><X>20</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// unico lugar donde se decide si la maquina puede trabajar.
// agregar aca los motivos nuevos de parada (ej. rotura) en vez de mensajes nuevos.
return main.daPiso && main.dentroDeJornada() && !inState( FullWaitCart );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1787832068265</Id>
					<Name><![CDATA[tasaCosechaActual]]></Name>
					<X>390</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Tasa de cosecha efectiva. Es DERIVADA, no latcheada.
// tankControl entra y sale de Harvesting/WithCart por mensajes que no saben
// nada de puedeTrabajar(): si cada Entry recalcula harvestRate() a secas,
// el tanque se llena con la maquina parada. getSpeed() NO se va a 0 con stop().
return trabajando ? harvestRate() / second() : 0;]]></Body>
				</Function>
			</Functions>
