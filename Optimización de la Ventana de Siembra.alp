				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1169735952562</Id>
					<Name><![CDATA[MoveHarvesting]]></Name>
					<X>620</X><Y>340</Y>
					<Label><X>10</X><Y>200</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="170" Height="210">
						<EntryAction><![CDATA[// arranca a cosechar: lo transcurrido hasta aca fue tiempo detenida
main.horasDetenida += ( time() - tUltimoEstado ) / hour();
tUltimoEstado = time();]]></EntryAction>
						<ExitAction><![CDATA[//remember where stopped in the current row
YCompleted = YCompletedNow();
// deja de cosechar: lo transcurrido fue labor efectiva
main.horasCosechando += ( time() - tUltimoEstado ) / hour();
tUltimoEstado = time();]]></ExitAction>
