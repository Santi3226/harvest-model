			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1170071738331</Id>
					<Name><![CDATA[onCompleted]]></Name>
					<X>-200</X><Y>-550</Y>
					<Label><X>20</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int hrs = (int)( time() / hour() );
int min = (int)( ( time() % hour() ) / minute() );
textTimeCompleted.setText( "Completed in " + hrs + " hours " + min + " minutes" );
// un lote terminado. Si faltan lotes, la maquina vuelve a salir sola:
// siembraCompleta sigue en false y la condicion de Parked -> GoingToField la deja pasar.
lotesCompletados++;
if ( lotesCompletados < cantidadLotes ) return;
// campania cerrada
diaFinSiembra = diaCampania;
campaniaNro++;
traceln( "=== CAMPANIA " + campaniaNro + " CERRADA | superficie=" + (int)( cantidadLotes * 104 )
         + " ha | fin el dia " + diaFinSiembra + " de la ventana"
         + " | " + ( diaFinSiembra <= 45 ? "DENTRO del 15/nov" : "FUERA del 15/nov" ) );
siembraCompleta = true;
auditarMasa();
if ( terminarAlCerrarCampania ) { getEngine().finish(); return; }
cicloCultivo.onChange();
//getEngine().finish();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1786000000404</Id>
					<Name><![CDATA[actualizarSilo]]></Name>
					<X>750</X><Y>-500</Y>
					<Label><X>20</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double dt = time() - tUltimoSilo;
nivelSilo = max( 0.0, nivelSilo + tasaSilo * dt );
tUltimoSilo = time();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1786000000409</Id>
					<Name><![CDATA[auditarMasa]]></Name>
					<X>750</X><Y>-460</Y>
					<Label><X>20</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// fuerza la puesta al dia de los cuatro recipientes y verifica conservacion
combine.actualizarNivel();
cart.actualizarNivel();
truck.actualizarNivel();
actualizarSilo();
double enSistema = combine.nivel + cart.nivel + truck.nivel + nivelSilo;
double fuga = totalCosechado - enSistema - masaDescartada + masaInventada;
double pct = totalCosechado > 0 ? 100 * fuga / totalCosechado : 0;
traceln( "AUDITORIA t=" + time() + " | cosechado=" + totalCosechado + " enSistema=" + enSistema
         + " descartado=" + masaDescartada + " inventado=" + masaInventada
         + " | FUGA=" + fuga + " (" + pct + "%)" );
double dCos = horasCosechando - baseCosechando;
double dDet = horasDetenida - baseDetenida;
traceln( "CAMPANIA " + campaniaNro + " | cosechando=" + dCos + " h | detenida=" + dDet
         + " h | uso=" + (int)( 100 * dCos / max( 1e-9, dCos + dDet ) )
         + "% | viajes camion=" + (int)( viajesCamion - baseViajes )
         + " | dias sin piso=" + ( diasSinPiso - baseSinPiso )
         + " | dia fin siembra=" + diaFinSiembra );]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1786000000901</Id>
					<Name><![CDATA[cargarClima]]></Name>
					<X>1200</X><Y>80</Y>
					<Label><X>20</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// series NASA POWER embebidas como texto: campanias separadas por ; y dias por ,
// se guardan como String y no como literal de arreglo porque un metodo de la JVM
// no puede pasar de 65535 bytes de bytecode
String[] fuentes = { climaLluvia, climaTmedia, climaEt0 };
double[][][] r = new double[3][][];
for ( int k = 0; k < 3; k++ ) {
	String[] filas = fuentes[k].split( ";" );
	r[k] = new double[ filas.length ][];
	for ( int i = 0; i < filas.length; i++ ) {
		String[] c = filas[i].split( "," );
		r[k][i] = new double[ c.length ];
		for ( int j = 0; j < c.length; j++ ) r[k][i][j] = Double.parseDouble( c[j] );
	}
}
lluviaDiaria = r[0];
tmediaDiaria = r[1];
et0Diaria    = r[2];]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1786000001601</Id>
					<Name><![CDATA[dentroDeJornada]]></Name>
					<X>1200</X><Y>560</Y>
					<Label><X>20</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// Ley 26.727: 8 h diarias y 44 semanales POR OPERARIO.
// La maquina puede trabajar mas horas si se cubren con varios turnos,
// asi que las horas-maquina por dia son una decision, no un supuesto.
// La jornada semanal se distribuye de forma uniforme sobre los 7 dias:
// durante la ventana de siembra se trabaja tambien fin de semana
// (tarea estacional, art. 8 del regimen).
double horasDia = min( 24.0, horasSemanales * turnos / 7.0 );
if ( horasDia >= 24.0 ) return true;
double h = ( time( HOUR ) - horaInicio ) % 24;
if ( h < 0 ) h += 24;
return h < horasDia;]]></Body>
				</Function>
			</Functions>
