		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1169735952575">
			<Id>1786475402591</Id>
			<Name><![CDATA[ParametersVariation]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode><![CDATA[// el FileWriter de After simulation run abre en modo append, asi que sin esto
// las filas nuevas se apilan sobre las viejas y quedan 600 sin forma de separarlas
java.io.File f = new java.io.File( "resultados.csv" );
if ( f.exists() ) f.delete();
try {
    java.io.PrintWriter w = new java.io.PrintWriter( f );
    w.println( "lotes;turnos;campania;diaFinSiembra" );
    w.close();
} catch ( Exception e ) {
    traceln( "!!! NO SE PUDO INICIAR resultados.csv: " + e );
}]]></BeforeEachExperimentRunCode>
			<AfterSimulationRunCode><![CDATA[try {
    java.io.PrintWriter w = new java.io.PrintWriter(
        new java.io.FileWriter( "resultados.csv", true ) );
    w.println( root.cantidadLotes + ";" + root.turnos + ";"
             + root.campania + ";" + root.diaFinSiembra );
    w.close();
} catch ( Exception e ) {
    // el catch mudo era el problema: el barrido corria, no escribia nada
    // y no habia forma de enterarse hasta ir a buscar el archivo
    traceln( "!!! NO SE PUDO ESCRIBIR resultados.csv: " + e );
}]]></AfterSimulationRunCode>
