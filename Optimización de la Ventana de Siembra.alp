			<StatechartElements>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1169735952504</Id>
					<Name><![CDATA[AtUnloading]]></Name>
					<X>120</X><Y>370</Y>
					<Label><X>10</X><Y>150</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="170" Height="160">
						<FillColor>-657956</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="AtUnloading" ParentStateId="1169735952504">
					<Id>1169735952503</Id>
					<Name><![CDATA[Unloading]]></Name>
					<X>150</X><Y>470</Y>
					<Label><X>10</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="110" Height="30">
						<EntryAction><![CDATA[// sin la Fluid Library el camion ya no se llena por conexion de puertos:
// hay que avisarle para que entre en Loading y acumule
send( "START_LOADING", main.truck );
actualizarNivel();
main.truck.actualizarNivel();
// El carro fija LAS DOS tasas. Si solo fijara la propia, un START_LOADING perdido
// (camion ya en Loading) lo haria drenar contra un camion que no acumula:
// -20.000 kg por carga, y ningun clamp lo registra porque el nivel no cruza cero.
tasaActual = -UnloadingRate / second();
main.truck.tasaActual = UnloadingRate / second();
tUltimo = time();
main.truck.tUltimo = time();
if ( inState( AtUnloading ) ) { trBecameEmpty.cancel(); trBecameEmpty.start(); }
if ( main.truck.inState( Truck.Loading ) ) { main.truck.transition5.cancel(); main.truck.transition5.start(); }]]></EntryAction>
						<ExitAction><![CDATA[actualizarNivel();
tasaActual = 0;
// corta el acople en los dos lados. transition5 NO se rearma aca a proposito:
// si el carro sale porque el camion se lleno, transition5 es la que esta disparando
// y cancelarla tira RuntimeException (aprendizaje 2 del contexto).
main.truck.actualizarNivel();
main.truck.tasaActual = 0;]]></ExitAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="AtUnloading" ParentStateId="1169735952504">
					<Id>1169735952502</Id>
					<Name><![CDATA[WaitTruck]]></Name>
					<X>150</X><Y>390</Y>
					<Label><X>10</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="110" Height="30">
						<FillColor>-29696</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1169735952505</Id>
					<Name><![CDATA[Loading]]></Name>
					<X>150</X><Y>240</Y>
					<Label><X>15</X><Y>15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="110" Height="30">
						<EntryAction><![CDATA[send( "STARTED_UNLOADING", main.combine );
//synchronize speed with combine
setSpeed( main.combine.getSpeed() );
//start moving with combine
moveWithCombine();
actualizarNivel();
// la tasa la fija la cosechadora al entrar en WithCart: es la unica que sabe
// cuanto grano hay disponible. Sin acople, el carro no recibe nada.
tasaActual = 0;
tUltimo = time();]]></EntryAction>
						<ExitAction><![CDATA[send( "FINISHED_UNLOADING", main.combine );
//restore original speed
setSpeed( Speed, KPH );
actualizarNivel();
tasaActual = 0;]]></ExitAction>
						<FillColor>-6632142</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1169735952506</Id>
					<Name><![CDATA[GoingToUnload]]></Name>
					<X>150</X><Y>310</Y>
					<Label><X>10</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="110" Height="30">
						<EntryAction><![CDATA[moveTo( Parking.getX(), Parking.getY() );]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1169735952507</Id>
					<Name><![CDATA[GoingToCombine]]></Name>
					<X>150</X><Y>170</Y>
					<Label><X>10</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="110" Height="30">
						<EntryAction><![CDATA[//go to combine
double x = main.combine.getX() - main.combine.RowWidth; 
double y = main.combine.getY();
moveTo( x, y );
]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
