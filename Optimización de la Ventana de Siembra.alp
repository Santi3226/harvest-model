					<Properties Source="1169735952505" Target="1169735952506" Trigger="timeout">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[tasaActual > 0 ? ( ( Capacity - nivel ) / tasaActual ) / second() : 1e12]]></Code>
