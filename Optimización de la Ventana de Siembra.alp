				<StatechartElement Class="Transition" ParentState="ROOT_NODE">
					<Id>1169735952552</Id>
					<Name><![CDATA[transition5]]></Name>
					<X>620</X><Y>480</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<Points>
						<Point><X>0</X><Y>0</Y></Point>
						<Point><X>-50</X><Y>0</Y></Point>
					</Points>
					<IconOffset>19.0</IconOffset>
					<Properties Source="1169735952562" Target="1169735952561" Trigger="condition">
						<Action><![CDATA[stop();
// PARA: hay que congelar la cadena de masa, no solo el movimiento.
// MoveWaitCart no es substate de Harvesting, asi que Harvesting.Exit NO corre.
actualizarNivel();                    // integra con la tasa VIEJA antes de pisarla
trabajando = false;
tasaCosecha = 0;
if ( inState( WithCart ) ) {
	main.cart.actualizarNivel();
	main.cart.tasaActual = 0;
	if ( main.cart.inState( Cart.Loading ) ) { main.cart.Full.cancel(); main.cart.Full.start(); }
} else {
	tasaActual = 0;
	if ( inState( Loading ) ) { Full.cancel(); Full.start(); }
}
traceln( "### MAQUINA PARA | dia " + main.diaCampania
         + " | piso=" + main.daPiso
         + " jornada=" + main.dentroDeJornada()
         + " tolvaLlena=" + inState( FullWaitCart )
         + " | humedad=" + main.humedadSuperficie
         + " nivelTolva=" + (int) nivel
         + " | t=" + time( DAY ) + " d" );]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Condition><![CDATA[!puedeTrabajar()]]></Condition>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
