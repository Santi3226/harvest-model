		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1169735952575</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[// series climaticas NASA POWER embebidas: se parsean una sola vez
cargarClima();

int n = Xunits.length;

// Calcular columnas y filas proporcionales a las dimensiones del lote (520x320)
int columnas = (int) Math.sqrt(n * (field.getWidth() / field.getHeight()));
int filas = (int) Math.ceil((double) n / columnas);

// Calcular la distancia exacta entre cada planta
double espaciadoX = field.getWidth() / columnas;
double espaciadoY = field.getHeight() / filas;

// Distribuir el cultivo en la grilla
for (int i = 0; i < n; i++) {
    int col = i % columnas;
    int fila = i / columnas;
    Xunits[i] = col * espaciadoX;
    Yunits[i] = fila * espaciadoY;
}]]></StartupCode>
