					<Properties Width="110" Height="30">
						<EntryAction><![CDATA[//go to the SW corner of field
double x = Field.getX() + RowWidth / 2; //half width of combine
double y = Field.getY() + Field.getHeight();
moveTo( x, y );
// arranca la campania: los meses de maduracion con la maquina en Parked
// no son tiempo detenido, no se le imputan al uso
tUltimoEstado = time();
]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1169735952565</Id>
					<Name><![CDATA[Parked]]></Name>
					<X>650</X><Y>220</Y>
					<Label><X>10</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
