					<Properties Width="110" Height="30">
						<EntryAction><![CDATA[// solo llamar al carro si la parada es porque falta el carro.
// Si la maquina paro por piso o por jornada, el carro no tiene nada que hacer aca.
if ( main.autoControl && inState( FullWaitCart ) )
	send( "GO_TO_COMBINE", main.cart );]]></EntryAction>
