				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1169735952747</Id>
					<Name><![CDATA[Unloading]]></Name>
					<X>150</X><Y>330</Y>
					<Label><X>10</X><Y>20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="110" Height="30">
						<EntryAction><![CDATA[actualizarNivel();
main.viajesCamion++;
traceln( "VIAJE " + (int)main.viajesCamion + " | dia " + time( DAY ) + " | carga " + nivel
         + " kg de " + Capacity + " (" + (int)( 100 * nivel / Capacity ) + "%)" );
tasaActual = -UnloadingRate / second();
tUltimo = time();
main.actualizarSilo();
main.tasaSilo = UnloadingRate / second();
main.tUltimoSilo = time();]]></EntryAction>
						<ExitAction><![CDATA[actualizarNivel();
tasaActual = 0;
main.actualizarSilo();
main.tasaSilo = 0;]]></ExitAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
