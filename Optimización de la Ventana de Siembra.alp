					<Id>1169735952495</Id>
					<Name><![CDATA[trBecameEmpty]]></Name>
					<X>120</X><Y>450</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<Points>
						<Point><X>0</X><Y>0</Y></Point>
						<Point><X>-30</X><Y>0</Y></Point>
						<Point><X>-30</X><Y>-330</Y></Point>
						<Point><X>30</X><Y>-330</Y></Point>
					</Points>
					<IconOffset>269.0</IconOffset>
					<Properties Source="1169735952504" Target="1169735952508" Trigger="timeout">
						<Action><![CDATA[send( "FINISHED_LOADING", main.truck );]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[tasaActual < 0 ? ( nivel / -tasaActual ) / second() : 1e12]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
