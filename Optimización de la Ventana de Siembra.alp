					</Properties>	
				</StatechartElement>
				<StatechartElement Class="Transition" ParentState="ROOT_NODE">
					<Id>1786000001003</Id>
					<Name><![CDATA[tickDiario]]></Name>
					<X>470</X><Y>420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Points>
						<Point><X>0</X><Y>0</Y></Point>
						<Point><X>40</X><Y>-40</Y></Point>
						<Point><X>-40</X><Y>-40</Y></Point>
						<Point><X>-30</X><Y>0</Y></Point>
					</Points>
					<IconOffset>20.0</IconOffset>
					<Properties Source="1786000001002" Target="1786000001002" Trigger="timeout">
						<Action><![CDATA[// paso horario: la condicion de jornada cambia dos veces por dia y
// las condiciones no se reevaluan solas, asi que hay que forzarlo cada hora
horaTick++;
combine.moveControl.onChange();
// OJO: nada de 'return' en una accion de transicion. AnyLogic las despacha desde
// un metodo compartido (executeActionOf) y el return saltea el rearmado de la
// autotransicion: el tick corria una sola vez y diaCampania quedaba clavado en 0.
if ( horaTick % 24 == 0 ) {
	// el balance hidrico solo avanza mientras haya serie; el resto del dia
	// (onChange del ciclo de cultivo) tiene que seguir corriendo igual, si no
	// la campania se congela al agotarse los 212 dias de la serie.
	if ( diaCampania < lluviaDiaria[ campania ].length - 1 ) {
		diaCampania++;
		double lluvia = lluviaDiaria[ campania ][ diaCampania ];
		double etc    = kc * et0Diaria[ campania ][ diaCampania ];
		humedadSuperficie = max( 0, min( capacidadSuperficie, humedadSuperficie + lluvia - etc ) );
		if ( inState( Creciendo ) ) gdd += max( 0, tmediaDiaria[ campania ][ diaCampania ] - tBase );
		// piso: superficie seca Y que no haya llovido fuerte hoy
		boolean piso = humedadSuperficie <= umbralPiso && lluvia < lluviaBloqueante;
		if ( !piso ) diasSinPiso++;
		if ( diaCampania <= diasLogClima )
			traceln( "CLIMA dia " + diaCampania + " | lluvia=" + lluvia + " etc=" + etc
			         + " humedad=" + humedadSuperficie + " piso=" + piso );
		if ( piso != daPiso ) {
			daPiso = piso;
			traceln( ( piso ? ">>> PISO RECUPERADO" : ">>> PISO PERDIDO" ) + " dia " + diaCampania
			         + " | humedad=" + humedadSuperficie + " lluvia=" + lluvia );
			combine.moveControl.onChange();
		}
	} else if ( daPiso == false ) {
		// serie agotada: no dejar la maquina clavada por un piso congelado
		daPiso = true;
		traceln( ">>> SERIE CLIMATICA AGOTADA dia " + diaCampania + " — se libera el piso" );
		combine.moveControl.onChange();
	}
	cicloCultivo.onChange();
}]]></Action>
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[HOUR]]></Unit>
						</Timeout>
						<Condition><![CDATA[true]]></Condition>
