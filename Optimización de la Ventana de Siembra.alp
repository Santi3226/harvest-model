						<Action><![CDATA[// arranca el lote: el flag decide si tankControl va a acumular o no
trabajando = puedeTrabajar();
//starting harvesiting field
XCompleted = 0; //no rows completed
YCompleted = Field.getHeight(); //starting from South
YDirection = NORTH; //and going North
//notify tank controller
send( "STARTED_HARVESTING", this );]]></Action>
